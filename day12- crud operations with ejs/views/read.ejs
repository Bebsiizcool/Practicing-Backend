<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/style.css">
    
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
   <div class="w-full h-full bg-zinc-900 p-10 text-white">

        <div class="nav mb-10">
        <a class="text-blue-500" href="/">Back to Home</a>
    </div>

    <h1 class="text-3xl tracking-tigher mb-3">All Users</h1>
    <div class="users flex gap-3 flex-wrap">
        
        <% allusers.forEach(function(e){%>
            <div class="user w-72 p-4 bg-zinc-800 rounded-lg ">
            <div class="img w-full h-52 rounded-lg bg-zinc-700 overflow-hidden">
                <img class="w-full h-full object-cover" src="<%= e.image %>" alt="">
            </div>
            <h3 class="text-xl tracking-tighter mt-3 "><%= e.name %></h3>
            <h5 class="text-zinc-500"><%= e.email %></h5>
            <div class="flex gap-3 mt-10">
                <a class="text-zinc-300" href="">Edit User</a>
                <a class="text-red-600" href="/delete/<%= e._id %>">Delete User</a>
            </div>
        </div>
        <%}) %>
       

    </div>
        
   </div>
</body>
</html>