<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini-Project</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body >
    <div class="h-screen w-full bg-zinc-900 text-white p-10 ">
    <a class="px-6 py-2 bg-red-800" href="/logout"> Logout</a>
    <div class="flex flex-col items-center mt-40" >
    
        <h3 class="mb-5 text-3xl">Edit Your Post</h3>
        <form action="/update/<%=post._id%>" method="POST">
            <textarea placeholder="Whats on your mind?" class="p-3 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md w-130 " name="content"> <%= post.content%></textarea>
            <input class="px-3 py-1 block bg-yellow-600 cursor-pointer w-130 mt-2 rounded-md" type="submit" value="Edit Post">
        </form> 
    </div>
    </div>
</body>
</html>