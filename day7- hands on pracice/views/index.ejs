<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white">
        <div class="form p-10">
            <form action="/create" method="post">
                <input name="title" class="block w-full px-5 py-2 bg-zinc-700 rounded-md outline-none" type="text"
                    placeholder="Title goes here">
                <textarea name="yellow" class=" w-full block mt-2 px-5 py-2 bg-zinc-700 rounded-md resize-none outline-none"
                    placeholder="Write your Task Details"></textarea>
                <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="Create Task">
            </form>
        </div>

        <div class="  task p-10 flex gap-4 flex-warp">

            <% if (files.length> 0) { %>

                <% files.forEach(function(val) { %>

                    <div class="  task min-w-72 px-3 py-4 bg-zinc-700 rounded-md">
                        <h1 class="text-white text-2xl tracking-tighter"><%= val %></h1>
                        <a class="text-blue-500 inline-block mt-3" href="">Read More</a>
                    </div>

                    <% }) %>

                        <% } else { %>

                            <h3 class="text-zinc-300">No Tasks Yet</h3>

                            <% } %>





        </div>
    </div>
</body>

</html>